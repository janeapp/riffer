# Arity patch for the `anthropic` gem (see openai.rbs for the rationale). Both
# `Messages#create` and `Messages#stream` are positional `def x(params)` at
# runtime but typed keyword-only in the gem's RBS. Streaming returns `untyped`
# (a MessageStream helper). Loaded only for riffer's own Steep run.
module Anthropic
  module Resources
    class Messages
      def create: (Hash[Symbol, untyped] params) -> Anthropic::Models::Message
                | (**untyped) -> Anthropic::Models::Message
                | ...

      def stream: (Hash[Symbol, untyped] params) -> untyped
                | (**untyped) -> untyped
    end
  end
end
